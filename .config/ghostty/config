# Ghostty. Docs: ghostty +show-config --default --docs
theme = Catppuccin Mocha
# Mocha "crust": same palette, darker floor
background = #11111b
font-size = 13
window-save-state = always
macos-option-as-alt = true
mouse-hide-while-typing = true

# Claude Code and others emit OSC 9;4 progress; the bar across the tab is distracting
progress-style = false
