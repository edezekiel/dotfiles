# Core tools for my everyday workflow. Install with: brew bundle --global
# Work-specific tools live in ~/.Brewfile.work (untracked).

brew "coreutils"
brew "curl"
brew "direnv"
brew "eza"
brew "gh"
brew "git-delta"
brew "gnupg"
brew "mise"
brew "pandoc"
brew "rtk"
brew "terminal-notifier"
brew "yamlfmt"
brew "yazi"

cask "font-symbols-only-nerd-font"
cask "warp"
