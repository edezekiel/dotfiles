# Core tools for my everyday workflow. Install with: brew bundle --global
# Machine-specific tools live in ~/.Brewfile.local (untracked).

brew "betterleaks"
brew "coreutils"
brew "curl"
brew "direnv"
brew "eza"
brew "gh"
brew "git-delta"
brew "gnupg"
brew "mise"
brew "pandoc"
brew "rtk"
brew "starship"
brew "terminal-notifier"
brew "tmux"
brew "yamlfmt"
brew "yazi"

cask "1password"
cask "docker-desktop"
cask "font-hack-nerd-font"
cask "font-symbols-only-nerd-font"
cask "google-chrome"
cask "raycast"
cask "slack"
cask "warp"
