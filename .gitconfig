[user]
	email = ed.a.ezekiel@gmail.com
	name = Edward Ezekiel
	signingkey = ~/.ssh/id_sign_ed25519
[paper]
	branch = false
[core]
  	editor = code --wait
[merge]
    tool = default-mergetool
[mergetool "default-mergetool"]
    cmd = code --wait $MERGED
[diff]
    tool = default-difftool
[difftool "default-difftool"]
    cmd = code --wait --diff $LOCAL $REMOTE
[pager]
	diff = false
	branch = false
[alias]
	co = checkout
	br = branch
	ci = commit
        st = status
        lg = log -n 3 --oneline
	sw = switch
[init]
	defaultBranch = main
[gpg]
	format = ssh
[commit]
	gpgsign = true
[gpg "ssh"]
	allowedSignersFile = /Users/edward/.ssh/allowed_signers
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
