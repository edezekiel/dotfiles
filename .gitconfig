[user]
	email = ed.a.ezekiel@gmail.com
	name = Edward Ezekiel
	signingkey = ~/.ssh/id_sign_ed25519
[core]
	editor = code --wait
	pager = delta
[merge]
	tool = default-mergetool
	conflictStyle = zdiff3
[mergetool "default-mergetool"]
	cmd = code --wait $MERGED
[diff]
	tool = default-difftool
[difftool "default-difftool"]
	cmd = code --wait --diff $LOCAL $REMOTE
[pager]
	branch = false
[alias]
	co = checkout
	br = branch
	ci = commit
	st = status
	lg = log -n 3 --oneline
	sw = switch
	p = grep --heading --break -n
[init]
	defaultBranch = main
[gpg]
	format = ssh
[commit]
	gpgsign = true
[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	dark = true
	side-by-side = true
	line-numbers = true

# Machine-specific overrides, not tracked in dotfiles
[include]
	path = ~/.gitconfig.local
